---
import Layout from '../layouts/Layout.astro';
import TodoList from '../components/TodoList.jsx';
---

<Layout title="Minhas Tarefas">
	<main class="max-w-3xl mx-auto p-4 py-8">
        <header class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-extrabold text-gray-800">Minhas Tarefas</h1>
            <button 
                id="logoutBtn"
                class="text-sm bg-gray-200 hover:bg-gray-300 text-gray-700 py-2 px-4 rounded font-medium transition"
            >
                Sair
            </button>
        </header>

		<TodoList client:load />
	</main>
</Layout>

<script>
    // Proteção simples de rota client-side
    if (!localStorage.getItem('token')) {
        window.location.href = '/';
    }

    // Lógica de logout
    document.getElementById('logoutBtn')?.addEventListener('click', () => {
        localStorage.removeItem('token');
        window.location.href = '/';
    });
</script>